<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="colorAccent">#292c30</color>
    <color name="colorPrimary">#292c30</color>
    <color name="colorPrimaryDark">#292c30</color>
    <color name="ic_launcher_background">#FFFFFF</color>
    <string name="app_name">Sona</string>
    <string name="custom_url_scheme">com.sona.app</string>
    <string name="package_name">com.sona.app</string>
    <string name="title_activity_main">Sona</string>
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>